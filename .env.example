# Marketplace — example environment.
# Copy to `.env` and adjust. Do NOT commit your real `.env` (it is gitignored).
# All values below are safe local placeholders — fill secrets per environment.

ENV=development
VERSION=local
LOG_LEVEL=info
# HTTP port the service listens on
PORT=9982
SERVER_PORT=9982
# Public domain of the deployment (used for building absolute URLs)
DOMAIN=localhost

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
DB_TYPE=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=marketplaces

# Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Cross-service config ────────────────────────────────────────────────────
# Platform / gateway service (auth, org, user)
PLATFORM_HOST=http://localhost:6040
BACKEND_HOST=http://localhost:6040
# Channel service (conversations, provider channels)
CHANNEL_SERVICE_URL=http://localhost:4100
# AI service
AI_SERVICE=http://localhost:7100
AI_SERVICE_V2=http://localhost:8080
# Data board / knowledge hub service
KNOWLEDGE_HUB=http://localhost:8081
# Route CRM board calls through the data board service
CRMBOARD_USE_DATABOARD=false
# Workflow hosts (optional; blank = workflow resolution skipped)
WORKFLOW_HOST=
AP_WORKFLOW_HOST=

# ─── AWS S3 (optional) — leave blank locally ─────────────────────────────────
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=

# ─── Kafka (optional) — leave blank/off locally ──────────────────────────────
KAFKA_CLIENT_ID=marketplace
KAFKA_ENDPOINT=
KAFKA_USE_SSL=false
KAFKA_USE_SASL=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ─── Channel provider tokens — fill per environment ──────────────────────────
FACEBOOK_VERIFY_TOKEN=
